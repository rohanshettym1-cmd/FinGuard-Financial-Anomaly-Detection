# Local Compose configuration. Run: python scripts/setup_env.py --demo
# These are paths to ignored secret files, NOT passwords.
MYSQL_PASSWORD_FILE=.secrets/mysql-password
MYSQL_ROOT_PASSWORD_FILE=.secrets/mysql-root-password
WEB_PORT=8088
DEMO_ENABLED=false
ML_ENABLED=true
ML_CONNECT_TIMEOUT_MS=500
ML_REQUEST_TIMEOUT_MS=2000
