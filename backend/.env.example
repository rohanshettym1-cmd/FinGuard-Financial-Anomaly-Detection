# Documentation only: Spring Boot does not automatically load .env files.
# Export these variables in your shell before starting the backend.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/finguard?connectionTimeZone=UTC
DB_USERNAME=
DB_PASSWORD=
DETECTION_ENABLED=true
DETECTION_POLL_DELAY_MS=2000
ML_ENABLED=true
ML_BASE_URL=http://localhost:8000
ML_CONNECT_TIMEOUT_MS=300
ML_REQUEST_TIMEOUT_MS=1000
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opt in only for an empty local/demo database. Existing nonempty databases are skipped.
DEMO_ENABLED=false
